# Supabase dashboard -> Connect -> "Session pooler" (IPv4, port 5432).
# Leave the password out of the URL and put it in DATABASE_PASSWORD exactly as-is;
# special characters need no encoding there.
# The direct connection (db.<ref>.supabase.co) also works if your network has IPv6.
# Avoid the transaction pooler (port 6543) for loading data.
DATABASE_URL=postgresql://postgres.<project-ref>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_PASSWORD=
